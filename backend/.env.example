# Environment Configuration for Gujarat Sentinel Backend API

# PostgreSQL Connection String (Supabase / Neon / Render Postgres / Local)
# Supabase Transaction Pooler (recommended for serverless/Render):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or Supabase Direct:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://cctv_admin:cctv_password123@127.0.0.1:5432/cctv_registry_db

# Allowed CORS Origins (comma-separated domains or * for wildcard)
# For production: https://your-frontend-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment (development / production)
ENVIRONMENT=development

# Server Host and Port (Render dynamically assigns PORT)
HOST=0.0.0.0
PORT=8000

# Required to store discovered ONVIF camera credentials encrypted at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ONVIF_CREDENTIALS_KEY=

# Required single-admin login. Use a long random password and keep this file private.
ADMIN_PASSWORD=
SESSION_SIGNING_KEY=

# Judges' live camera catalogue and media gateway.
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
SENTINEL_STREAM_HOST=103.250.160.189
# Optional judge camera credentials, keyed by camera ID, stored only in backend/.env:
# {"CAM01":{"username":"...","password":"..."}}
SENTINEL_STREAM_CREDENTIALS_JSON=
